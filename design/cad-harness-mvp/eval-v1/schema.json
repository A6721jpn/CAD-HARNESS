{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frozen human suite gold and independent analytic fixture targets v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "case_id",
    "description",
    "description_sha256",
    "units",
    "frame",
    "tolerances",
    "bbox",
    "volume",
    "regions",
    "sections",
    "steps",
    "holes",
    "pockets",
    "finish",
    "editability",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "cad-harness.gold.v1"
    },
    "case_id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "description_sha256": {
      "type": "string"
    },
    "units": {
      "const": "mm"
    },
    "frame": {
      "enum": [
        "world",
        "bbox_relative"
      ]
    },
    "tolerances": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "linear_mm",
        "axis",
        "volume_relative"
      ],
      "properties": {
        "linear_mm": {
          "const": 0.01
        },
        "axis": {
          "const": 0.000001
        },
        "volume_relative": {
          "const": 0.0001
        }
      }
    },
    "bbox": {
      "$ref": "#/$defs/bounds6"
    },
    "volume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_mm3",
        "relative",
        "formula"
      ],
      "properties": {
        "target_mm3": {
          "type": "number"
        },
        "relative": {
          "enum": [
            0.0001,
            0.01
          ]
        },
        "upper_exclusive": {
          "type": "number"
        },
        "formula": {
          "type": "string"
        }
      }
    },
    "regions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/region"
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "holes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hole"
      }
    },
    "pockets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pocket"
      }
    },
    "finish": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/finish"
        }
      ]
    },
    "editability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "key_dimensions_mm"
      ],
      "properties": {
        "required": {
          "const": true
        },
        "key_dimensions_mm": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "decision",
        "version",
        "confirmed"
      ],
      "properties": {
        "authority": {
          "enum": ["human", "fixture"]
        },
        "decision": {
          "type": "string"
        },
        "version": {
          "const": 1
        },
        "confirmed": {
          "type": "boolean"
        },
        "source": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "pair": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "bounds4": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      }
    },
    "bounds6": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "number"
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bounds"
      ],
      "properties": {
        "bounds": {
          "$ref": "#/$defs/bounds6"
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "z",
        "kind",
        "bounds"
      ],
      "properties": {
        "z": {
          "type": "number"
        },
        "kind": {
          "const": "rectangle"
        },
        "bounds": {
          "$ref": "#/$defs/bounds4"
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "center_xy",
        "diameter",
        "z"
      ],
      "properties": {
        "center_xy": {
          "$ref": "#/$defs/pair"
        },
        "diameter": {
          "type": "number"
        },
        "z": {
          "$ref": "#/$defs/pair"
        }
      }
    },
    "hole": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "center_xy",
        "diameter",
        "z",
        "through"
      ],
      "properties": {
        "center_xy": {
          "$ref": "#/$defs/pair"
        },
        "diameter": {
          "type": "number"
        },
        "z": {
          "$ref": "#/$defs/pair"
        },
        "through": {
          "const": true
        }
      }
    },
    "pocket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bounds",
        "top_z",
        "depth",
        "sharp"
      ],
      "properties": {
        "bounds": {
          "$ref": "#/$defs/bounds4"
        },
        "top_z": {
          "type": "number"
        },
        "depth": {
          "type": "number"
        },
        "sharp": {
          "const": true
        }
      }
    },
    "finish": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "size",
        "target"
      ],
      "properties": {
        "kind": {
          "enum": [
            "fillet",
            "chamfer"
          ]
        },
        "size": {
          "type": "number"
        },
        "target": {
          "const": "top_outer"
        }
      }
    }
  }
}
