{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAD harness declarative build specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "family"
  ],
  "properties": {
    "schema": {
      "const": "cad-harness.build-spec.v1"
    },
    "family": {
      "enum": [
        "rect_prism",
        "rect_stack",
        "stepped_shaft"
      ]
    },
    "units": {
      "enum": [
        "mm",
        "cm",
        "m"
      ],
      "default": "mm"
    },
    "frame": {
      "const": "world",
      "default": "world"
    },
    "regions": {
      "type": "array",
      "description": "Bottom-up, base first. Each region requires six bounds including z_min/z_max; higher regions start at a prior top and lie inside that region in XY.",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/region"
      }
    },
    "center_xy": {
      "$ref": "#/$defs/pair"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "pockets": {
      "type": "array",
      "maxItems": 8,
      "default": [],
      "items": {
        "$ref": "#/$defs/pocket"
      }
    },
    "holes": {
      "type": "array",
      "maxItems": 64,
      "default": [],
      "items": {
        "$ref": "#/$defs/hole"
      }
    },
    "finish": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/finish"
        }
      ],
      "default": null
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "family": {
            "const": "rect_prism"
          }
        }
      },
      "then": {
        "required": [
          "regions"
        ],
        "properties": {
          "regions": {
            "maxItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "family": {
            "const": "rect_stack"
          }
        }
      },
      "then": {
        "required": [
          "regions"
        ],
        "properties": {
          "regions": {
            "minItems": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "family": {
            "const": "stepped_shaft"
          }
        }
      },
      "then": {
        "required": [
          "steps"
        ]
      }
    }
  ],
  "$defs": {
    "pair": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "bounds4": {
      "type": "array",
      "description": "Exactly [x_min,x_max,y_min,y_max]. Pocket top_z and depth are separate required fields.",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      }
    },
    "bounds6": {
      "type": "array",
      "description": "Exactly [x_min,x_max,y_min,y_max,z_min,z_max]; both z coordinates are required.",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "number"
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bounds"
      ],
      "properties": {
        "bounds": {
          "$ref": "#/$defs/bounds6"
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diameter",
        "z"
      ],
      "properties": {
        "diameter": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "z": {
          "$ref": "#/$defs/pair"
        }
      }
    },
    "pocket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bounds",
        "top_z",
        "depth"
      ],
      "properties": {
        "bounds": {
          "$ref": "#/$defs/bounds4"
        },
        "top_z": {
          "type": "number"
        },
        "depth": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "hole": {
      "type": "object",
      "description": "Through hole: required z equals the pierced region's full [bottom,top]. No pocket/hole or hole/hole overlap, nor blocked openings.",
      "additionalProperties": false,
      "required": [
        "center_xy",
        "diameter",
        "z"
      ],
      "properties": {
        "center_xy": {
          "$ref": "#/$defs/pair"
        },
        "diameter": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "z": {
          "$ref": "#/$defs/pair"
        }
      }
    },
    "finish": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "size",
        "target"
      ],
      "properties": {
        "kind": {
          "enum": [
            "fillet",
            "chamfer"
          ]
        },
        "size": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "target": {
          "const": "top_outer"
        }
      }
    }
  }
}
