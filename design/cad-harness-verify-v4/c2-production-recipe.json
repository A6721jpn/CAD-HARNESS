{
  "schema": "cad-harness.contour-recipe.v4c",
  "profile": "c-s1",
  "foreground": {
    "channel": "alpha",
    "polarity": "light",
    "threshold": 128
  },
  "alpha": {
    "policy": "ignore"
  },
  "scale": {
    "canonical_height_mm": 50.0,
    "origin_mm": [0.0, 0.0]
  },
  "curve_fit": {
    "method": "periodic_cubic_biarc_v1",
    "maximum_error_pixels": 1.0,
    "tangent_span_pixels": 2.0,
    "smoothing_rms_pixels": 0.35,
    "sample_spacing_pixels": 1.0,
    "biarc_error_pixels": 0.05,
    "maximum_fit_passes": 4,
    "corner_angle_degrees": 60.0
  },
  "simplify": {
    "allowed": false
  },
  "rounding": {
    "allowed": false
  },
  "limits": {
    "max_deviation_mm": 1.5,
    "approximation_tolerance_mm": 0.005
  },
  "topology": {
    "components": 1,
    "holes": "preserve",
    "islands": "reject"
  }
}
