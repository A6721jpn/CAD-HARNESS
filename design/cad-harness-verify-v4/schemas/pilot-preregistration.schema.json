{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "External pilot authorization of the exact rubric and input index; not a rubric status rewrite",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "status", "authority", "authority_evidence", "trial_id", "cycle_id", "rubric_sha256", "input_sha256", "acknowledges_draft_rubric", "previous_manifest_sha256"],
  "properties": {
    "schema": {"const": "cad-harness.pilot-preregistration.v1"},
    "status": {"const": "approved"},
    "authority": {"enum": ["user", "authorized_custodian"]},
    "authority_evidence": {"type": "string", "minLength": 1},
    "trial_id": {"type": "string", "minLength": 1},
    "cycle_id": {"type": "string", "minLength": 1},
    "rubric_sha256": {"$ref": "#/$defs/sha"},
    "input_sha256": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/sha"}, "description": "Exact file-ID/hash map, excluding this document and the separate retry authorization to avoid self-reference."},
    "acknowledges_draft_rubric": {"type": "boolean", "description": "Must be true when the bound public rubric still says draft or not-preregistered."},
    "previous_manifest_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha"}]}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
