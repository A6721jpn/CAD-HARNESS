{
  "$id": "cad-harness.live-trial.v1",
  "type": "object",
  "required": [
    "schema",
    "phase",
    "trial_id",
    "cycle_id",
    "freeze_dir",
    "evidence_mode",
    "registration",
    "authorization",
    "integrated_lock",
    "registration_data",
    "source_files",
    "public_bindings",
    "authority_claim",
    "reserved_calls",
    "quota_snapshot",
    "omp_profile",
    "omp",
    "generators",
    "judge",
    "host",
    "live_calls",
    "final_v4_ready",
    "sha256_file"
  ],
  "properties": {
    "schema": {
      "const": "cad-harness.live-trial.v1"
    },
    "phase": {
      "enum": [
        "families",
        "benchmark",
        "pilot",
        "judge"
      ]
    },
    "trial_id": {
      "type": "string",
      "minLength": 1
    },
    "cycle_id": {
      "type": "string",
      "minLength": 1
    },
    "freeze_dir": {
      "type": "string",
      "minLength": 1
    },
    "evidence_mode": {
      "enum": [
        "live",
        "unit_mock"
      ]
    },
    "registration": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "authorization": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "integrated_lock": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "registration_data": {
      "$id": "cad-harness.live-registration.v1",
      "type": "object",
      "required": [
        "schema",
        "phase",
        "trial_id",
        "cycle_id",
        "source_root",
        "files"
      ],
      "properties": {
        "schema": {
          "const": "cad-harness.live-registration.v1"
        },
        "phase": {
          "enum": [
            "families",
            "benchmark",
            "pilot",
            "judge"
          ]
        },
        "trial_id": {
          "type": "string",
          "minLength": 1
        },
        "cycle_id": {
          "type": "string",
          "minLength": 1
        },
        "source_root": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "path",
              "sha256",
              "bytes",
              "role"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "role": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "source_files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": true
      }
    },
    "public_bindings": {
      "type": "object",
      "additionalProperties": {"$ref": "#/properties/registration"}
    },
    "authority_claim": {
      "type": "object",
      "required": ["schema", "records"],
      "properties": {
        "schema": {"const": "cad-harness.live-authority-record.v1"},
        "records": {
          "type": "array", "minItems": 2, "maxItems": 3,
          "items": {"$ref": "#/properties/registration"}
        }
      },
      "additionalProperties": false
    },
    "reserved_calls": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "quota_snapshot": {
      "type": "string",
      "minLength": 1
    },
    "omp_profile": {
      "type": "string",
      "minLength": 1
    },
    "omp": {
      "type": "object"
    },
    "generators": {
      "type": "object"
    },
    "judge": {
      "type": "object"
    },
    "host": {
      "type": "string",
      "minLength": 1
    },
    "live_calls": {
      "const": 0
    },
    "final_v4_ready": {
      "const": false
    },
    "sha256_file": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
