{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "cad-harness.prepared.v4c"
    },
    "profile": {
      "const": "c-s1"
    },
    "source_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "assets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "step-facts.schema.json"
          },
          {
            "$ref": "contour.schema.json"
          }
        ]
      }
    }
  },
  "required": [
    "schema",
    "profile",
    "source_manifest_sha256",
    "assets"
  ],
  "additionalProperties": false
}
