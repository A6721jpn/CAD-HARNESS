{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Headless same-card human-correction proof; no generation or model re-score",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "check_id", "binding", "timer", "before", "native_finished", "finished", "elapsed_s", "status", "native_verdict", "artifact_bundle", "submission", "first_handover_snapshot", "native_evidence", "session_ledger", "error", "evidence_mode", "live_calls"],
  "properties": {
    "schema": {"const": "cad-harness.pilot-correction-proof.v1"},
    "check_id": {"type": "string", "pattern": "^check-[0-9]{6,}$"},
    "binding": {"$ref": "pilot-correction-start.schema.json#/$defs/binding"},
    "timer": {"$ref": "pilot-correction-start.schema.json#/$defs/file"},
    "before": {"$ref": "pilot-correction-start.schema.json#/$defs/stamp"},
    "native_finished": {"$ref": "pilot-correction-start.schema.json#/$defs/stamp"},
    "finished": {"$ref": "pilot-correction-start.schema.json#/$defs/stamp"},
    "elapsed_s": {"type": "number", "minimum": 0, "description": "Conservative maximum of observed system-monotonic and UTC elapsed from the exclusive start, including edits, waits and every earlier check. Values above 300 cannot PASS."},
    "status": {"enum": ["PASS", "FAIL", "UNVERIFIED", "ERROR", "EXPIRED"]},
    "native_verdict": {"type": "object"},
    "artifact_bundle": {"$ref": "pilot-correction-start.schema.json#/$defs/file"},
    "submission": {"$ref": "pilot-correction-start.schema.json#/$defs/submission"},
    "first_handover_snapshot": {"$ref": "pilot-correction-start.schema.json#/$defs/snapshot"},
    "native_evidence": {"type": "object", "additionalProperties": {"$ref": "pilot-correction-start.schema.json#/$defs/file"}},
    "session_ledger": {"$ref": "pilot-correction-start.schema.json#/$defs/file"},
    "error": {"type": ["null", "object"]},
    "evidence_mode": {"enum": ["live", "unit_mock"]},
    "live_calls": {"const": 0}
  }
}
