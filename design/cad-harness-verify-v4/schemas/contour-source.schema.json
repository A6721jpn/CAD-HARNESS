{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "cad-harness.contour-source.v4c"
    },
    "profile": {
      "const": "c-s1"
    },
    "units": {
      "const": "mm"
    },
    "bounds_mm": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "nominal_width_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "loops": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "outer",
              "hole"
            ]
          },
          "segments": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "line"
                    },
                    "p0": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "p1": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 2,
                      "maxItems": 2
                    }
                  },
                  "required": [
                    "kind",
                    "p0",
                    "p1"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "arc"
                    },
                    "p0": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "pm": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "p1": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 2,
                      "maxItems": 2
                    }
                  },
                  "required": [
                    "kind",
                    "p0",
                    "pm",
                    "p1"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "bezier"
                    },
                    "poles": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "minItems": 2,
                        "maxItems": 2
                      },
                      "minItems": 3,
                      "maxItems": 4
                    }
                  },
                  "required": [
                    "kind",
                    "poles"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "minItems": 1
          },
          "parent": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "role",
          "segments"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "source_image_asset_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    }
  },
  "required": [
    "schema",
    "profile",
    "units",
    "bounds_mm",
    "nominal_width_mm",
    "loops",
    "source_image_asset_id"
  ],
  "additionalProperties": false
}
