{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "cad-harness.bare-runtime-staging.v1",
  "description": "Actual pre-trial exclusive byte-copy software/environment preparation, not hidden task preparation. This file must be outside the copied runtime and frozen alongside its inventory before authorization. Metadata is insufficient: admission rehashes both complete trees and binds the original canonical Python pin, relocated Python identity and current isolation implementation. Failure has no host-execution or weak-isolation fallback.",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "source_root", "root", "source_python", "python", "inventory_sha256", "isolation_sha256", "purpose", "copy_method", "live_calls", "started_utc", "finished_utc", "monotonic_interval", "boot_id"],
  "properties": {
    "schema": {"const": "cad-harness.bare-runtime-staging.v1"}, "source_root": {"type": "string"}, "root": {"type": "string"},
    "source_python": {"$ref": "#/$defs/python"}, "python": {"$ref": "#/$defs/python"},
    "inventory_sha256": {"$ref": "#/$defs/sha"}, "isolation_sha256": {"$ref": "#/$defs/sha"},
    "purpose": {"const": "pretrial_software_environment"}, "copy_method": {"const": "exclusive_byte_copy_no_links"}, "live_calls": {"const": 0},
    "started_utc": {"type": "string", "format": "date-time"}, "finished_utc": {"type": "string", "format": "date-time"},
    "monotonic_interval": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0}}, "boot_id": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "python": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha"}, "bytes": {"type": "integer", "minimum": 0}}}
  }
}
