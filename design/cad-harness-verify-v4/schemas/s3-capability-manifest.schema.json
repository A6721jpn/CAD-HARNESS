{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cad-harness.capability-manifest.v4c.c-s3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "stage",
    "status",
    "authorization",
    "freeze_dir",
    "files",
    "skill_sha256",
    "policy_sha256",
    "host",
    "runtime",
    "original_profile_snapshot",
    "prior_stage_snapshot",
    "generators",
    "judge",
    "recipes",
    "dev",
    "pending_final_freeze",
    "final_v4_ready",
    "sha256_file"
  ],
  "properties": {
    "schema": {
      "const": "cad-harness.capability-manifest.v4c"
    },
    "profile": {
      "const": "c-s3"
    },
    "stage": {
      "$ref": "capability-manifest.schema.json#/properties/stage"
    },
    "status": {
      "$ref": "capability-manifest.schema.json#/properties/status"
    },
    "authorization": {
      "type": "null"
    },
    "freeze_dir": {
      "$ref": "capability-manifest.schema.json#/properties/freeze_dir"
    },
    "files": {
      "$ref": "capability-manifest.schema.json#/properties/files"
    },
    "skill_sha256": {
      "$ref": "capability-manifest.schema.json#/properties/skill_sha256"
    },
    "policy_sha256": {
      "$ref": "capability-manifest.schema.json#/properties/policy_sha256"
    },
    "host": {
      "$ref": "capability-manifest.schema.json#/properties/host"
    },
    "original_profile_snapshot": {
      "$ref": "capability-manifest.schema.json#/properties/original_profile_snapshot"
    },
    "prior_stage_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "path",
        "sha256"
      ],
      "properties": {
        "profile": {
          "const": "c-s2"
        },
        "path": {
          "const": "design/cad-harness-verify-v4/s2-profile-snapshot.zip"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "generators": {
      "$ref": "capability-manifest.schema.json#/properties/generators"
    },
    "judge": {
      "$ref": "capability-manifest.schema.json#/properties/judge"
    },
    "recipes": {
      "$ref": "capability-manifest.schema.json#/properties/recipes"
    },
    "dev": {
      "$ref": "capability-manifest.schema.json#/properties/dev"
    },
    "pending_final_freeze": {
      "$ref": "capability-manifest.schema.json#/properties/pending_final_freeze"
    },
    "final_v4_ready": {
      "const": false
    },
    "sha256_file": {
      "$ref": "capability-manifest.schema.json#/properties/sha256_file"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "profile",
        "operation",
        "status",
        "owned_pid",
        "freecad_version",
        "gui_up",
        "python_executable",
        "python_version",
        "document_closed",
        "dependencies",
        "native_libraries",
        "occt_version",
        "runtime"
      ],
      "properties": {
        "profile": {
          "const": "c-s3"
        },
        "schema": {
          "$ref": "capability-manifest.schema.json#/properties/runtime/properties/schema"
        },
        "operation": {
          "$ref": "capability-manifest.schema.json#/properties/runtime/properties/operation"
        },
        "status": {
          "$ref": "capability-manifest.schema.json#/properties/runtime/properties/status"
        },
        "owned_pid": {
          "$ref": "capability-manifest.schema.json#/properties/runtime/properties/owned_pid"
        },
        "freecad_version": {
          "$ref": "capability-manifest.schema.json#/properties/runtime/properties/freecad_version"
        },
        "gui_up": {
          "$ref": "capability-manifest.schema.json#/properties/runtime/properties/gui_up"
        },
        "python_executable": {
          "$ref": "capability-manifest.schema.json#/properties/runtime/properties/python_executable"
        },
        "python_version": {
          "$ref": "capability-manifest.schema.json#/properties/runtime/properties/python_version"
        },
        "document_closed": {
          "$ref": "capability-manifest.schema.json#/properties/runtime/properties/document_closed"
        },
        "dependencies": {
          "$ref": "capability-manifest.schema.json#/properties/runtime/properties/dependencies"
        },
        "native_libraries": {
          "$ref": "capability-manifest.schema.json#/properties/runtime/properties/native_libraries"
        },
        "occt_version": {
          "$ref": "capability-manifest.schema.json#/properties/runtime/properties/occt_version"
        },
        "runtime": {
          "$ref": "capability-manifest.schema.json#/properties/runtime/properties/runtime"
        }
      }
    }
  }
}
