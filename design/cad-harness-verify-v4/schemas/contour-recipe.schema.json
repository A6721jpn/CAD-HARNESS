{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "cad-harness.contour-recipe.v4c"
    },
    "profile": {
      "const": "c-s1"
    },
    "foreground": {
      "type": "object",
      "properties": {
        "channel": {
          "enum": [
            "luminance",
            "red",
            "green",
            "blue",
            "alpha"
          ]
        },
        "polarity": {
          "enum": [
            "dark",
            "light"
          ]
        },
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 255
        }
      },
      "required": [
        "channel",
        "polarity",
        "threshold"
      ],
      "additionalProperties": false
    },
    "alpha": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "policy": {
              "enum": [
                "ignore",
                "require-opaque"
              ]
            }
          },
          "required": [
            "policy"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "policy": {
              "const": "threshold"
            },
            "threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 255
            }
          },
          "required": [
            "policy",
            "threshold"
          ],
          "additionalProperties": false
        }
      ]
    },
    "scale": {
      "type": "object",
      "properties": {
        "mm_per_pixel": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "canonical_height_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "origin_mm": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "origin_mm"
      ],
      "oneOf": [
        {"required": ["mm_per_pixel"]},
        {"required": ["canonical_height_mm"]}
      ],
      "additionalProperties": false
    },
    "curve_fit": {
      "type": "object",
      "properties": {
        "method": {"const": "periodic_cubic_biarc_v1"},
        "maximum_error_pixels": {"type": "number", "exclusiveMinimum": 0},
        "tangent_span_pixels": {"type": "number", "exclusiveMinimum": 0},
        "smoothing_rms_pixels": {"type": "number", "exclusiveMinimum": 0},
        "sample_spacing_pixels": {"type": "number", "exclusiveMinimum": 0},
        "biarc_error_pixels": {"type": "number", "exclusiveMinimum": 0},
        "maximum_fit_passes": {"type": "integer", "minimum": 1, "maximum": 8},
        "corner_angle_degrees": {
          "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 180
        }
      },
      "required": ["method", "maximum_error_pixels", "tangent_span_pixels", "corner_angle_degrees",
                   "smoothing_rms_pixels", "sample_spacing_pixels", "biarc_error_pixels", "maximum_fit_passes"],
      "additionalProperties": false
    },
    "simplify": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "allowed": {
              "const": false
            }
          },
          "required": [
            "allowed"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "allowed": {
              "const": true
            },
            "tolerance_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "allowed",
            "tolerance_mm"
          ],
          "additionalProperties": false
        }
      ]
    },
    "rounding": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "allowed": {
              "const": false
            }
          },
          "required": [
            "allowed"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "allowed": {
              "const": true
            },
            "radius_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "allowed",
            "radius_mm"
          ],
          "additionalProperties": false
        }
      ]
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_deviation_mm": {
          "type": "number",
          "minimum": 0
        },
        "approximation_tolerance_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "max_deviation_mm",
        "approximation_tolerance_mm"
      ],
      "additionalProperties": false
    },
    "topology": {
      "type": "object",
      "properties": {
        "components": {
          "enum": [1, "preserve"]
        },
        "holes": {
          "const": "preserve"
        },
        "islands": {
          "enum": ["reject", "preserve"]
        }
      },
      "required": [
        "components",
        "holes",
        "islands"
      ],
      "additionalProperties": false,
      "oneOf": [
        {"properties": {"components": {"const": 1}, "islands": {"const": "reject"}}},
        {"properties": {"components": {"const": "preserve"}, "islands": {"const": "preserve"}}}
      ]
    }
  },
  "required": [
    "schema",
    "profile",
    "foreground",
    "alpha",
    "scale",
    "simplify",
    "rounding",
    "limits",
    "topology"
  ],
  "additionalProperties": false
}
