{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "External user evidence bound to the immutable first pilot handover",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "authority", "source_id", "evidence_sha256", "trial_id", "cycle_id", "manifest_sha256", "record_id", "handover_sha256", "visual_status", "first_handover_accepted", "correction_elapsed_s", "correction_proof", "critical_dimension_error", "fabrication"],
  "properties": {
    "schema": {"const": "cad-harness.pilot-user-verdict.v1"},
    "authority": {"const": "user"},
    "source_id": {"type": "string", "minLength": 1},
    "evidence_sha256": {"$ref": "#/$defs/sha"},
    "trial_id": {"type": "string", "minLength": 1},
    "cycle_id": {"type": "string", "minLength": 1},
    "manifest_sha256": {"$ref": "#/$defs/sha"},
    "record_id": {"enum": ["U1", "U2", "U3", "U4", "U5"]},
    "handover_sha256": {"$ref": "#/$defs/sha"},
    "visual_status": {"enum": ["PASS", "FAIL", "UNVERIFIED"]},
    "first_handover_accepted": {"type": "boolean"},
    "correction_elapsed_s": {"type": "number", "minimum": 0, "description": "Actual user-reported elapsed seconds, including waits. Any positive value requires the latest bound native correction proof; the independently timed proof must finish within 300 seconds."},
    "correction_proof": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/file"}]},
    "critical_dimension_error": {"type": "boolean"},
    "fabrication": {"type": "boolean"}
  },
  "allOf": [{"if": {"properties": {"correction_elapsed_s": {"const": 0}}}, "then": {"properties": {"correction_proof": {"type": "null"}}}, "else": {"properties": {"correction_proof": {"$ref": "#/$defs/file"}}}}],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha"}, "bytes": {"type": "integer", "minimum": 0}}}
  }
}
