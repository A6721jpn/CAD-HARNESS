{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cad-harness.step-facts.v4c.c-s3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "asset_id",
    "source_sha256",
    "units",
    "bounds_mm",
    "topology",
    "frame",
    "faces",
    "coverage",
    "recipe_sha256",
    "provenance",
    "signature_precision_mm"
  ],
  "properties": {
    "schema": {
      "const": "cad-harness.step-facts.v4c"
    },
    "profile": {
      "const": "c-s3"
    },
    "asset_id": {
      "$ref": "step-facts.schema.json#/properties/asset_id"
    },
    "source_sha256": {
      "$ref": "step-facts.schema.json#/properties/source_sha256"
    },
    "units": {
      "$ref": "step-facts.schema.json#/properties/units"
    },
    "bounds_mm": {
      "$ref": "step-facts.schema.json#/properties/bounds_mm"
    },
    "topology": {
      "$ref": "step-facts.schema.json#/properties/topology"
    },
    "frame": {
      "$ref": "step-facts.schema.json#/properties/frame"
    },
    "coverage": {
      "$ref": "step-facts.schema.json#/properties/coverage"
    },
    "recipe_sha256": {
      "$ref": "step-facts.schema.json#/properties/recipe_sha256"
    },
    "provenance": {
      "$ref": "step-facts.schema.json#/properties/provenance"
    },
    "signature_precision_mm": {
      "$ref": "step-recipe.schema.json#/properties/signature_precision_mm"
    },
    "faces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "signature",
          "ambiguous",
          "surface_type",
          "area_mm2",
          "center_mm",
          "bounds_mm",
          "normal",
          "normal_kind",
          "normal_reason",
          "adjacent_face_ids",
          "parameterization"
        ],
        "properties": {
          "id": {
            "$ref": "step-facts.schema.json#/properties/faces/items/properties/id"
          },
          "signature": {
            "$ref": "step-facts.schema.json#/properties/faces/items/properties/signature"
          },
          "ambiguous": {
            "$ref": "step-facts.schema.json#/properties/faces/items/properties/ambiguous"
          },
          "surface_type": {
            "$ref": "step-facts.schema.json#/properties/faces/items/properties/surface_type"
          },
          "area_mm2": {
            "$ref": "step-facts.schema.json#/properties/faces/items/properties/area_mm2"
          },
          "center_mm": {
            "$ref": "step-facts.schema.json#/properties/faces/items/properties/center_mm"
          },
          "bounds_mm": {
            "$ref": "step-facts.schema.json#/properties/faces/items/properties/bounds_mm"
          },
          "normal": {
            "$ref": "step-facts.schema.json#/properties/faces/items/properties/normal"
          },
          "normal_kind": {
            "$ref": "step-facts.schema.json#/properties/faces/items/properties/normal_kind"
          },
          "normal_reason": {
            "$ref": "step-facts.schema.json#/properties/faces/items/properties/normal_reason"
          },
          "adjacent_face_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^Face[1-9][0-9]*$"
            }
          },
          "parameterization": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "domain_uv",
              "corner_points_mm",
              "degree_u",
              "degree_v",
              "reason"
            ],
            "properties": {
              "domain_uv": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number"
                }
              },
              "corner_points_mm": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number"
                  }
                }
              },
              "degree_u": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "degree_v": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "reason": {
                "enum": [
                  null,
                  "non_spline_surface"
                ]
              }
            }
          }
        }
      }
    }
  }
}
