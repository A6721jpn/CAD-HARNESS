{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cad-harness.cad-time-benchmark.v1",
  "description": "Sealed operational execution dataset, not a reinterpretation of opaque custodian pair-record bytes. Values are observations or explicitly null; human construction fields are not applicable.",
  "oneOf": [{"$ref": "#/$defs/dataset"}, {"$ref": "#/$defs/event"}, {"$ref": "#/$defs/index"}],
  "$defs": {
    "dataset": {
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "trial_id", "comparison", "status", "evidence_mode", "conditions", "pairs", "event_prefix_sha256", "enrolled_pairs", "enrolled_conditions", "qualified_conditions", "censored_conditions", "per_arm", "limitations", "runtime"],
  "properties": {
    "schema": {"const": "cad-harness.cad-time-benchmark.v1"},
    "trial_id": {"type": "string", "minLength": 1},
    "comparison": {"const": "harness-versus-bare-agent"},
    "status": {"enum": ["not_run", "completed_with_enrolled_outcomes", "awaiting_human_verdicts"]},
    "evidence_mode": {"enum": ["live", "unit_mock"]},
    "conditions": {"type": "array", "minItems": 40, "maxItems": 40, "items": {"$ref": "#/$defs/condition"}},
    "pairs": {"type": "array", "minItems": 20, "maxItems": 20, "items": {"type": "object", "required": ["pair", "family", "savings"], "properties": {"pair": {"type": "string", "pattern": "^B(0[1-9]|1[0-9]|20)$"}, "family": {"enum": ["C1", "C2", "C3", "C4", "C5"]}, "savings": {"type": "object", "required": ["full_wall_s", "service_s", "active_s", "native_cad_s"], "additionalProperties": {"$ref": "#/$defs/saving"}}}}},
    "event_prefix_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "enrolled_pairs": {"const": 20},
    "enrolled_conditions": {"const": 40},
    "qualified_conditions": {"type": "integer", "minimum": 0, "maximum": 40},
    "censored_conditions": {"type": "integer", "minimum": 0, "maximum": 40},
    "per_arm": {"type": "object", "required": ["with_harness", "bare"], "additionalProperties": {"type": "object", "required": ["enrolled", "qualified", "success_rate"], "properties": {"enrolled": {"const": 20}, "qualified": {"type": "integer", "minimum": 0, "maximum": 20}, "success_rate": {"type": "number", "minimum": 0, "maximum": 1}}}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "runtime": {"type": "object"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "supersedes": {"type": "object", "required": ["dataset_sha256", "hash_index_sha256", "event_prefix_sha256", "original_custody"]}
  }
    },
    "event": {
      "type": "object",
      "required": ["schema", "kind", "sequence", "previous_sha256", "trial_id", "utc", "monotonic", "sha256"],
      "properties": {
        "schema": {"const": "cad-harness.cad-time-benchmark.v1"}, "kind": {"type": "string"},
        "sequence": {"type": "integer", "minimum": 1}, "trial_id": {"type": "string"},
        "utc": {"type": "string"}, "monotonic": {"type": "number"},
        "previous_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "index": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "trial_id", "event_prefix_sha256", "event_count", "files"],
      "properties": {
        "schema": {"const": "cad-harness.cad-time-benchmark.v1"}, "trial_id": {"type": "string"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "event_prefix_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "event_count": {"type": "integer", "minimum": 1},
        "files": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false,
          "required": ["sha256", "bytes"], "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "bytes": {"type": "integer", "minimum": 0}}}}
      }
    },
    "saving": {"type": "object", "additionalProperties": false, "required": ["saving", "reduction_percent", "reason"], "properties": {"saving": {"type": ["number", "null"]}, "reduction_percent": {"type": ["number", "null"]}, "reason": {"type": ["string", "null"]}}},
    "condition": {"type": "object", "required": ["pair", "arm", "family", "stratum", "status", "reason", "qualified_completion", "completion_time_s", "right_censored", "timing", "first_handover", "final_handover", "construction_operator", "human_engineering_time"], "properties": {"pair": {"type": "string"}, "arm": {"enum": ["with_harness", "bare"]}, "family": {"enum": ["C1", "C2", "C3", "C4", "C5"]}, "stratum": {"type": "string"}, "status": {"type": "string"}, "reason": {"type": ["string", "null"]}, "qualified_completion": {"type": "boolean"}, "completion_time_s": {"type": ["number", "null"], "minimum": 0}, "right_censored": {"type": "boolean"}, "timing": {"type": "object", "required": ["full_wall_s", "service_s", "active_s", "native_cad_s"], "properties": {"full_wall_s": {"type": ["number", "null"], "minimum": 0}, "service_s": {"type": ["number", "null"], "minimum": 0}, "active_s": {"type": ["number", "null"], "minimum": 0}, "native_cad_s": {"type": ["number", "null"], "minimum": 0}}}, "construction_operator": {"const": {"value": null, "reason": "not_applicable"}}, "human_engineering_time": {"const": {"value": null, "reason": "not_applicable"}}}}
  }
}
