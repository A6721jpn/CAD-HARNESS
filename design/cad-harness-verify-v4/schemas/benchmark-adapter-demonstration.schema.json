{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cad-harness.benchmark-adapter-demonstration.v1",
  "description": "Actual independent DEV native/STEP and editability checks of ordinary and with-harness artifacts against one unchanged card. No model/provider calls or injected native process can produce this receipt through demonstrate_adapter.",
  "oneOf": [{"$ref": "#/$defs/proof"}, {"$ref": "#/$defs/index"}],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file_id": {"type": "string", "minLength": 1},
    "method": {
      "type": "object", "additionalProperties": false, "required": ["check", "bundle"],
      "properties": {"check": {"$ref": "#/$defs/file_id"}, "bundle": {"$ref": "#/$defs/file_id"}}
    },
    "proof": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "evidence_mode", "actual_native", "live_calls", "profile", "same_card_sha256", "methods", "hash_index"],
      "properties": {
        "schema": {"const": "cad-harness.benchmark-adapter-demonstration.v1"},
        "evidence_mode": {"const": "independent_dev"}, "actual_native": {"const": true}, "live_calls": {"const": 0},
        "profile": {"enum": ["c-s1", "c-s2", "c-s3"]}, "same_card_sha256": {"$ref": "#/$defs/sha"},
        "hash_index": {"$ref": "#/$defs/file_id"},
        "methods": {"type": "object", "additionalProperties": false, "required": ["with_harness", "ordinary"],
          "properties": {"with_harness": {"$ref": "#/$defs/method"}, "ordinary": {"$ref": "#/$defs/method"}}}
      }
    },
    "index": {
      "type": "object", "additionalProperties": false, "required": ["schema", "files", "live_calls"],
      "properties": {
        "schema": {"const": "cad-harness.benchmark-adapter-index.v1"}, "live_calls": {"const": 0},
        "files": {"type": "object", "minProperties": 1, "additionalProperties": {
          "type": "object", "additionalProperties": false, "required": ["sha256", "bytes"],
          "properties": {"sha256": {"$ref": "#/$defs/sha"}, "bytes": {"type": "integer", "minimum": 0}}
        }}
      }
    }
  }
}
