{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "cad-harness.contour.v4c"
        },
        "profile": {
          "const": "c-s1"
        },
        "asset_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "source_image_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "decoded_rgba_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mask_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "recipe_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "record_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "units": {
          "const": "mm"
        },
        "pixel_to_mm": {
          "type": "object",
          "properties": {
            "scale_mm_per_pixel": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "origin_mm": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "image_height_pixels": {
              "type": "integer",
              "minimum": 1
            },
            "y_axis": {
              "const": "up"
            },
            "pixel_convention": {
              "const": "closed unit cells; centers at (col+0.5,row+0.5)"
            }
          },
          "required": [
            "scale_mm_per_pixel",
            "origin_mm",
            "image_height_pixels",
            "y_axis",
            "pixel_convention"
          ],
          "additionalProperties": false
        },
        "bounds_mm": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "nominal_width_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "loops": {
          "type": "array",
          "description": "Final geometry in every branch: simple closed manifold loops with strictly separated boundaries and preserved nesting, independently certified by native admission. Raw v2 source-walk pinches are not permitted here.",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "enum": [
                  "outer",
                  "hole"
                ]
              },
              "segments": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "line"
                        },
                        "p0": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 2,
                          "maxItems": 2
                        },
                        "p1": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 2,
                          "maxItems": 2
                        }
                      },
                      "required": [
                        "kind",
                        "p0",
                        "p1"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "arc"
                        },
                        "p0": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 2,
                          "maxItems": 2
                        },
                        "pm": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 2,
                          "maxItems": 2
                        },
                        "p1": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 2,
                          "maxItems": 2
                        }
                      },
                      "required": [
                        "kind",
                        "p0",
                        "pm",
                        "p1"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "bezier"
                        },
                        "poles": {
                          "type": "array",
                          "items": {
                            "type": "array",
                            "items": {
                              "type": "number"
                            },
                            "minItems": 2,
                            "maxItems": 2
                          },
                          "minItems": 3,
                          "maxItems": 4
                        }
                      },
                      "required": [
                        "kind",
                        "poles"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "minItems": 1
              },
              "parent": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "role",
              "segments"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "source_loops": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "enum": [
                  "outer",
                  "hole"
                ]
              },
              "segments": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "line"
                        },
                        "p0": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 2,
                          "maxItems": 2
                        },
                        "p1": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 2,
                          "maxItems": 2
                        }
                      },
                      "required": [
                        "kind",
                        "p0",
                        "p1"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "arc"
                        },
                        "p0": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 2,
                          "maxItems": 2
                        },
                        "pm": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 2,
                          "maxItems": 2
                        },
                        "p1": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 2,
                          "maxItems": 2
                        }
                      },
                      "required": [
                        "kind",
                        "p0",
                        "pm",
                        "p1"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "bezier"
                        },
                        "poles": {
                          "type": "array",
                          "items": {
                            "type": "array",
                            "items": {
