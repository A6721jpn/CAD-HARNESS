                            },
                            "minItems": 2,
                            "maxItems": 2
                          },
                          "minItems": 3,
                          "maxItems": 4
                        }
                      },
                      "required": [
                        "kind",
                        "poles"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "minItems": 1
              },
              "parent": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "role",
              "segments"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "source_mask": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "encoding": {
              "const": "row-runs"
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "minItems": 0
              },
              "minItems": 1
            }
          },
          "required": [
            "width",
            "height",
            "encoding",
            "rows"
          ],
          "additionalProperties": false
        },
        "recipe": {
          "$ref": "contour-recipe.schema.json"
        },
        "topology": {
          "type": "object",
          "properties": {
            "source": {
              "type": "object",
              "properties": {
                "components": {
                  "type": "integer",
                  "minimum": 1
                },
                "holes": {
                  "type": "integer",
                  "minimum": 0
                },
                "euler_characteristic": {
                  "type": "integer"
                }
              },
              "required": [
                "components",
                "holes",
                "euler_characteristic"
              ],
              "additionalProperties": false
            },
            "output": {
              "type": "object",
              "properties": {
                "components": {
                  "type": "integer",
                  "minimum": 1
                },
                "holes": {
                  "type": "integer",
                  "minimum": 0
                },
                "euler_characteristic": {
                  "type": "integer"
                }
              },
              "required": [
                "components",
                "holes",
                "euler_characteristic"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "source",
            "output"
          ],
          "additionalProperties": false
        },
        "reports": {
          "type": "object",
          "properties": {
            "minimum_radius_mm": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "source_boundary_hausdorff_upper_mm": {
              "type": "number",
              "minimum": 0
            },
            "pinch_openings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "vertex_pixels": {
                    "type": "array",
                    "items": {"type": "integer", "minimum": 0},
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "incident_components": {
                    "type": "array",
                    "items": {"type": "integer", "minimum": 1},
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "clearance_mm_lower": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": ["vertex_pixels", "incident_components", "clearance_mm_lower"],
                "additionalProperties": false
              },
              "description": "Recomputed original y-up cell-contact vertices, sorted unique fg4 raster labels, and positive conservative clearance from FINAL MATERIAL; empty when no contacts."
            }
          },
          "required": [
            "minimum_radius_mm",
            "source_boundary_hausdorff_upper_mm"
          ],
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "properties": {
            "decoder": {
              "type": "string",
              "minLength": 1
            },
            "luminance": {
              "type": "string",
              "minLength": 1
            },
            "threshold_comparison": {
              "type": "string",
              "minLength": 1
            },
            "extraction": {
              "type": "string",
              "minLength": 1
            },
            "simplification": {
              "type": "string",
              "minLength": 1
            },
            "rounding": {
              "type": "string",
              "minLength": 1
            },
            "hash_encoding": {
              "type": "string",
              "minLength": 1
            },
            "source_checks": {
              "type": "string",
              "minLength": 1
            },
            "curve_approximation": {"type": "string", "minLength": 1},
            "scale_order": {"type": "string", "minLength": 1}
          },
          "required": [
            "decoder",
            "luminance",
            "threshold_comparison",
            "extraction",
            "simplification",
            "rounding",
            "hash_encoding",
            "source_checks"
          ],
          "additionalProperties": false
        },
        "approximation": {
          "type": "object",
          "properties": {
            "flatten_tolerance_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "flatten_error_bound_mm": {
              "type": "number",
              "minimum": 0
            },
            "source_deviation_upper_mm": {
              "type": "number",
              "minimum": 0
            },
            "deviation_method": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "flatten_tolerance_mm",
            "flatten_error_bound_mm",
            "source_deviation_upper_mm",
            "deviation_method"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema",
        "profile",
        "asset_id",
        "source_image_sha256",
        "source_manifest_sha256",
        "decoded_rgba_sha256",
        "mask_sha256",
        "recipe_sha256",
        "record_sha256",
        "units",
        "pixel_to_mm",
        "bounds_mm",
        "nominal_width_mm",
        "loops",
        "source_loops",
        "source_mask",
        "recipe",
        "topology",
        "reports",
        "provenance",
        "approximation"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "recipe": {
                "required": ["curve_fit"],
                "properties": {
                  "curve_fit": {
                    "required": ["method"],
                    "properties": {"method": {"const": "source_bounded_biarc_v2"}}
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "reports": {"required": ["pinch_openings"]},
              "source_loops": {
                "description": "Exact original mask-cell boundary walks with an independently labeled fg4/bg8 nesting forest; source walks alone may touch or self-touch. Final loops remain simple, manifold and strictly separated.",
                "items": {
                  "properties": {
                    "segments": {
                      "items": {"properties": {"kind": {"const": "line"}}}
                    }
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "reports": {"not": {"required": ["pinch_openings"]}},
              "source_loops": {
                "description": "Historical source loops require strict simple separated geometry; diagonal contacts are refused."
              }
            }
          }
        }
      ]
    },
