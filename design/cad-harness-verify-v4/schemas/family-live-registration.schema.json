{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cad-harness.family-execution-registration.v1",
  "description": "Operational execution index, NOT the unpublished private family-roster layout. Hash-binds opaque original roster and public commitment without rewriting either. Signed cardinality, strata, identities and gates are additionally enforced by validate_registration.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "execution_schema", "phase", "trial_id", "cycle_id", "source_root", "cohort", "files", "public_commitment", "rubric", "entries", "controls", "order"],
  "properties": {
    "schema": {"const": "cad-harness.live-registration.v1"},
    "execution_schema": {"const": "cad-harness.family-execution-registration.v1"},
    "phase": {"const": "families"},
    "trial_id": {"$ref": "#/$defs/id"},
    "cycle_id": {"$ref": "#/$defs/id"},
    "source_root": {"type": "string", "minLength": 1},
    "cohort": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "path", "sha256", "bytes"],
      "properties": {
        "schema": {"const": "cad-harness.family-roster.v1"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "files": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/file"}},
    "public_commitment": {"$ref": "#/$defs/id"},
    "rubric": {"$ref": "#/$defs/id"},
    "entries": {"type": "array", "minItems": 43, "maxItems": 43, "items": {"$ref": "#/$defs/entry"}},
    "controls": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/control"}},
    "order": {"type": "array", "minItems": 47, "maxItems": 47, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "custody": {"type": "object"},
    "durability": {"type": "object"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "role", "origin"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha"},
        "bytes": {"type": "integer", "minimum": 0},
        "role": {"type": "string", "minLength": 1},
        "origin": {"enum": ["published_cohort", "operational"]},
        "published_relative_path": {"type": "string", "minLength": 1}
      }
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "family", "profile", "stratum", "request", "input_manifest", "prepared", "card", "context", "model_inputs"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "family": {"enum": ["C1", "C2", "C3", "C4", "C5"]},
        "profile": {"enum": ["c-s1", "c-s2", "c-s3"]},
        "stratum": {"type": "string", "minLength": 1},
        "request": {"$ref": "#/$defs/id"},
        "input_manifest": {"$ref": "#/$defs/id"},
        "prepared": {"$ref": "#/$defs/id"},
        "card": {"$ref": "#/$defs/id"},
        "context": {"$ref": "#/$defs/id"},
        "model_inputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "images": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "control": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "profile", "checker", "inputs", "parameters", "invalidity_proof"],
      "properties": {
        "id": {"enum": ["AC-corrupt-step", "AC-open-contour", "AC-tool-infeasible", "AC-unavailable-glyph"]},
        "profile": {"const": "c-s1"},
        "checker": {"enum": ["inspect_step", "planar_geometry", "tool_access", "validate_context"]},
        "inputs": {"type": "object", "additionalProperties": {"$ref": "#/$defs/id"}},
        "parameters": {"type": "object"},
        "invalidity_proof": {"$ref": "#/$defs/id"}
      }
    }
  }
}
