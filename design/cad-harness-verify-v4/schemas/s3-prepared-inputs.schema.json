{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cad-harness.prepared.v4c.c-s3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "source_manifest_sha256",
    "assets"
  ],
  "properties": {
    "schema": {
      "const": "cad-harness.prepared.v4c"
    },
    "profile": {
      "const": "c-s3"
    },
    "source_manifest_sha256": {
      "$ref": "prepared-inputs.schema.json#/properties/source_manifest_sha256"
    },
    "assets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "s3-step-facts.schema.json"
      }
    }
  }
}
