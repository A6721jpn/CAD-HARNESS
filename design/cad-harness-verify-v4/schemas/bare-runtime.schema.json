{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "cad-harness.bare-runtime.v2",
  "description": "Closed byte-identical independent copy of the canonical pinned installed SDK, including all library, documentation and cache bytes. Both this inventory and its external staging proof are frozen before live authorization. The launcher rehashes source and destination, rejects links, aliases, missing/extra paths and installed-runtime ACL grants. Software/environment staging times are disclosed separately and are not task preparation or a causal timing claim.",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "freecad_version", "source_root", "root", "source_python", "files", "directories"],
  "properties": {
    "schema": {"const": "cad-harness.bare-runtime.v2"}, "freecad_version": {"const": "1.1.4"},
    "source_root": {"type": "string", "minLength": 1}, "root": {"type": "string", "minLength": 1},
    "source_python": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha"}, "bytes": {"type": "integer", "minimum": 0}}},
    "directories": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "files": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object", "additionalProperties": false,
      "required": ["sha256", "bytes"], "properties": {"sha256": {"$ref": "#/$defs/sha"}, "bytes": {"type": "integer", "minimum": 0}}}}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
