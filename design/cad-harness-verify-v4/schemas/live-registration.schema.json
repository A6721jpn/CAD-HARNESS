{
  "$id": "cad-harness.live-registration.v1",
  "type": "object",
  "required": [
    "schema",
    "phase",
    "trial_id",
    "cycle_id",
    "source_root",
    "files"
  ],
  "properties": {
    "schema": {
      "const": "cad-harness.live-registration.v1"
    },
    "phase": {
      "enum": [
        "families",
        "benchmark",
        "pilot",
        "judge"
      ]
    },
    "trial_id": {
      "type": "string",
      "minLength": 1
    },
    "cycle_id": {
      "type": "string",
      "minLength": 1
    },
    "source_root": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "bytes",
          "role"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
