{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One-shot Astra structured verdict; item IDs must exactly equal the bound rubric",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "rubric_id", "items", "critical_dimension_error", "fabrication"],
  "properties": {
    "schema": {"const": "cad-harness.model-verdict.v1"},
    "rubric_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "critical_dimension_error": {"type": "boolean"},
    "fabrication": {"type": "boolean"},
    "items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "status", "reason"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
          "status": {"enum": ["PASS", "FAIL", "UNVERIFIED"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
