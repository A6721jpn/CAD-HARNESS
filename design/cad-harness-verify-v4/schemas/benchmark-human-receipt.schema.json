{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "cad-harness.benchmark-human-receipt.v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "condition", "trial_id", "dataset_sha256", "files", "observed_at", "judge_id"],
  "properties": {
    "schema": {"const": "cad-harness.benchmark-human-receipt.v1"}, "condition": {"type": "string", "pattern": "^B(0[1-9]|1[0-9]|20):(with_harness|bare)$"},
    "trial_id": {"type": "string"}, "dataset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "files": {"type": "object", "additionalProperties": false, "required": ["verdict.json", "evidence.bin"], "properties": {"verdict.json": {"$ref": "#/$defs/file"}, "evidence.bin": {"$ref": "#/$defs/file"}}},
    "observed_at": {"type": "string", "format": "date-time"}, "judge_id": {"type": "string", "minLength": 1}
  },
  "$defs": {"file": {"type": "object", "additionalProperties": false, "required": ["sha256", "bytes"], "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "bytes": {"type": "integer", "minimum": 1}}}}
}
