{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Separate full-roster pilot retry cycle; fresh shared budget and quota required",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "status", "trial_id", "cycle_id", "previous_manifest_sha256", "budget", "fresh_quota_required", "authority_evidence"],
  "properties": {
    "schema": {"const": "cad-harness.pilot-retry-authorization.v1"},
    "status": {"const": "approved"},
    "trial_id": {"type": "string", "minLength": 1},
    "cycle_id": {"type": "string", "minLength": 1},
    "previous_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "budget": {"const": {"pilot": 40}},
    "fresh_quota_required": {"const": true},
    "authority_evidence": {"type": "string", "minLength": 1}
  }
}
