{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"cad-harness.inputs.v4c.c-s2",
  "type":"object","additionalProperties":false,
  "required":["schema","profile","evidence_mode","assets"],
  "properties":{
    "schema":{"const":"cad-harness.inputs.v4c"},
    "profile":{"const":"c-s2"},
    "evidence_mode":{"enum":["independent_dev","custodian"]},
    "assets":{
      "type":"object","minProperties":1,
      "propertyNames":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_-]{0,63}$"},
      "additionalProperties":{
        "type":"object","additionalProperties":false,
        "required":["kind","role","path","sha256","bytes"],
        "properties":{
          "kind":{"const":"step"},"role":{"enum":["reference","checker"]},
          "path":{"type":"string","minLength":1},
          "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
          "bytes":{"type":"integer","minimum":0}
        }
      }
    }
  }
}
