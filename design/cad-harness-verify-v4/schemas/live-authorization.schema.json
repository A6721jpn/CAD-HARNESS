{
  "$id": "cad-harness.live-trial-authorization.v1",
  "type": "object",
  "required": [
    "schema",
    "phase",
    "trial_id",
    "cycle_id",
    "approved_by",
    "user_approved",
    "clock_confirmation",
    "independent_control_validation",
    "registration_sha256",
    "integrated_manifest_sha256",
    "quota_snapshot",
    "omp_profile",
    "reserved_calls"
  ],
  "properties": {
    "schema": {
      "const": "cad-harness.live-trial-authorization.v1"
    },
    "phase": {
      "enum": [
        "families",
        "benchmark",
        "pilot",
        "judge"
      ]
    },
    "trial_id": {
      "type": "string",
      "minLength": 1
    },
    "cycle_id": {
      "type": "string",
      "minLength": 1
    },
    "approved_by": {
      "type": "string",
      "minLength": 1
    },
    "user_approved": {
      "const": true
    },
    "clock_confirmation": {
      "const": true
    },
    "independent_control_validation": {
      "const": true
    },
    "registration_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "integrated_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "quota_snapshot": {
      "type": "string",
      "minLength": 1
    },
    "omp_profile": {
      "type": "string",
      "minLength": 1
    },
    "reserved_calls": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    }
  },
  "additionalProperties": false
}
