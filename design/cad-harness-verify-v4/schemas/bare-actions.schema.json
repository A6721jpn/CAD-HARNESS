{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "cad-harness.bare-actions.v1",
  "type": "object", "additionalProperties": false, "required": ["actions", "handover"],
  "properties": {
    "actions": {"type": "array", "items": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["kind", "path", "content_base64"], "properties": {"kind": {"const": "write"}, "path": {"type": "string"}, "content_base64": {"type": "string", "contentEncoding": "base64"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "path"], "properties": {"kind": {"enum": ["read", "list"]}, "path": {"type": "string"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "args"], "properties": {"kind": {"const": "python"}, "args": {"type": "array", "items": {"type": "string"}}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "command"], "properties": {"kind": {"const": "shell"}, "command": {"type": "string"}}}
    ]}},
    "handover": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false,
      "required": ["native", "step", "source", "extensions", "output_object", "probes"],
      "properties": {"native": {"type": "string"}, "step": {"type": "string"}, "source": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "extensions": {"type": "array", "maxItems": 0}, "output_object": {"type": ["string", "null"]}, "probes": {"type": "array"}, "final": {"type": "boolean"}}
    }]}
  }
}
